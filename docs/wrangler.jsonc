{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "axumkit",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"placement": {
		"mode": "smart"
	}
}
