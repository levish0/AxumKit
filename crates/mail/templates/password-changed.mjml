<mjml>
  <mj-head><mj-attributes><mj-all font-family="Arial, sans-serif" /><mj-text font-size="16px" color="#243047" line-height="1.6" /></mj-attributes></mj-head>
  <mj-body background-color="#f3f5f8">
    <mj-section padding="40px 20px" background-color="#ffffff"><mj-column>
      <mj-text font-size="14px" color="#596579">{{ application_name }}</mj-text>
      <mj-text font-size="26px" font-weight="700">Your password was changed</mj-text>
      <mj-text>The password for your account was changed. All previous sessions have been revoked.</mj-text>
      <mj-text>If you did not make this change, contact the service operator and secure your account.</mj-text>
      <mj-button background-color="#2755c4" border-radius="6px" href="{{ action_url }}">Open {{ application_name }}</mj-button>
    </mj-column></mj-section>
  </mj-body>
</mjml>
