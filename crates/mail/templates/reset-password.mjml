<mjml>
  <mj-head><mj-attributes><mj-all font-family="Arial, sans-serif" /><mj-text font-size="16px" color="#243047" line-height="1.6" /></mj-attributes></mj-head>
  <mj-body background-color="#f3f5f8">
    <mj-section padding="40px 20px" background-color="#ffffff"><mj-column>
      <mj-text font-size="14px" color="#596579">{{ application_name }}</mj-text>
      <mj-text font-size="26px" font-weight="700">Reset your password</mj-text>
      <mj-text>We received a request to reset your password. Choose a new password using the link below.</mj-text>
      <mj-button background-color="#2755c4" border-radius="6px" href="{{ action_url }}">Reset password</mj-button>
      <mj-text>This link expires in 30 minutes and can be used once. Your password stays unchanged until you complete the reset.</mj-text>
      <mj-text font-size="13px" color="#596579">If you did not request this reset, you can ignore this message.</mj-text>
    </mj-column></mj-section>
  </mj-body>
</mjml>
