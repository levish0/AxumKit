APP_NAME="Hirune Axum Kit"
APP_ENV=development
PUBLIC_URL=http://localhost:3000/
ALLOWED_ORIGINS=http://localhost:3000
# Optional SSR proxy credential; use the same random secret in the SSR server.
INTERNAL_PROXY_SECRET=
BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=postgres://kit:local-development-only@localhost:54329/kit
MIGRATION_DATABASE_URL=postgres://kit:local-development-only@localhost:54329/kit
DATABASE_MAX_CONNECTIONS=10
# Run `just init` to generate independent local secrets.
ACTIVE_SECRET_KEY=local-v1
SECRET_KEYS='{}'
RATE_LIMIT_KEY=
SMTP_HOST=localhost
SMTP_PORT=10259
SMTP_STARTTLS=false
# Optional PEM root, used only with STARTTLS.
# SMTP_CA_CERTIFICATE=/run/certificates/smtp-ca.pem
MAIL_FROM="Hirune <noreply@example.test>"
SESSION_IDLE_SECONDS=1209600
SESSION_ABSOLUTE_SECONDS=7776000
PASSWORD_CONCURRENCY=4
AUTH_IDENTITY_LIMIT_PER_MINUTE=10
AUTH_CLIENT_LIMIT_PER_MINUTE=60
WORKER_CONCURRENCY=4
# Delay after an empty queue lookup; ready jobs do not wait between claims.
WORKER_POLL_MILLISECONDS=250
JOB_LEASE_SECONDS=30
JOB_EXECUTION_SECONDS=120
WORKER_DRAIN_SECONDS=35
SUCCEEDED_JOB_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
API_USAGE_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
MAINTENANCE_INTERVAL_SECONDS=300
# Optional FCM delivery; the inbox works without provider credentials.
FCM_ENABLED=false
# FCM_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
RUST_LOG=info,sqlx=off,sea_orm=off,reqwest=off,hyper=off
# OIDC and Sentry are optional; leave unset unless configured.
# JSON array of named OIDC providers; see docs/runtime.md for a multi-provider example.
OIDC_PROVIDERS=[]
# SENTRY_DSN=
# SENTRY_SAMPLE_RATE=0.05
# Optional Cloudflare Turnstile; an empty secret disables it. See docs/runtime.md.
# This Cloudflare test secret always passes. Production rejects test secrets.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Test responses carry no real action, so disable the action check with test keys.
# TURNSTILE_VERIFY_ACTION=false
# For optional originals and filename/post/profile search, start `just infra-up-files`.
# Uncomment and set the values below.
# After migrations, run `just manage initialize-integrations`.
# S3_ENDPOINT=http://localhost:8339/
# Optional client-facing S3 origin. The API uses S3_ENDPOINT for HEAD and cleanup.
# S3_PUBLIC_ENDPOINT=https://files.example.com/
# S3_BUCKET=kit-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=kit-local-access
# S3_SECRET_KEY=kit-local-development-secret-only
# S3_ALLOW_HTTP=true
# MEILISEARCH_URL=http://localhost:7709/
# MEILISEARCH_API_KEY=kit-local-meilisearch-key-development-only
# MEILISEARCH_ALLOW_HTTP=true
# MEILISEARCH_INDEX=files
# MEILISEARCH_POSTS_INDEX=posts
# MEILISEARCH_PROFILES_INDEX=profiles
FILE_MAX_BYTES=104857600
FILE_ORGANIZATION_QUOTA_BYTES=1073741824
FILE_ORGANIZATION_LIMIT=10000
FILE_PENDING_LIMIT=100
FILE_RESERVATIONS_PER_MINUTE=30
FILE_TOMBSTONE_DAYS=30
FILE_UPLOAD_URL_SECONDS=300
FILE_DOWNLOAD_URL_SECONDS=60
# Must cover the storage ingress's maximum in-flight PUT duration.
FILE_UPLOAD_GRACE_SECONDS=3600
